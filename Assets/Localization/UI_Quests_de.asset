  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: UI_Quests_de
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: f08e391c545fdab4d9c91542a36284fb, type: 2}
  m_Metadata:
    m_Items:
    - rid: 9040802075139375378
  m_TableData:
  - m_Id: 5438910464
    m_Localized: "Une vague de m\xE9t\xE9orite approche, j'ai peur  ! "
    m_Metadata:
      m_Items: []
  - m_Id: 285480005632
    m_Localized: 'Reinigen Sie den Weltraum von Meteoren :'
    m_Metadata:
      m_Items: []
  - m_Id: 85868537655296
    m_Localized: Uns geht das Eisen aus. Zielt auf Eisen-Meteoriten, um mehr zu sammeln!
      Verbessert die Schmiede, um mehr aus jedem Einschlag herauszuholen!
    m_Metadata:
      m_Items: []
  - m_Id: 86366347014144
    m_Localized: "Tues des m\xE9t\xE9orites de bois : "
    m_Metadata:
      m_Items: []
  - m_Id: 336272101945344
    m_Localized: 'Verbessere dein Schiff mit Eisen :'
    m_Metadata:
      m_Items: []
  - m_Id: 336869618298880
    m_Localized: "Um l\xE4nger zu \xFCberleben, muss unser Schiff verst\xE4rkt werden!
      Verwende dein Eisen, um es aufzur\xFCsten."
    m_Metadata:
      m_Items: []
  - m_Id: 466121177116672
    m_Localized: "Obt\xE9n part\xEDculas estelares con un solo prestigio :"
    m_Metadata:
      m_Items: []
  - m_Id: 466124553531392
    m_Localized: "Jetzt, wo wir st\xE4rker sind, ist es Zeit zu handeln. Zerst\xF6re
      Meteoriten!"
    m_Metadata:
      m_Items: []
  - m_Id: 470882718789632
    m_Localized: "Il faut vite trouver une solution ! Si on ne d\xE9truis pas ce
      boss on va\u2026 on sera foutu."
    m_Metadata:
      m_Items: []
  - m_Id: 738363026911232
    m_Localized: "Il faut absolument qu\u2019on d\xE9couvre ce qu\u2019il y a d\xE9rri\xE8re
      la poussi\xE8re d\u2019\xE9toile. Peut \xEAtre qu\u2019elle pourra nous sauver."
    m_Metadata:
      m_Items: []
  - m_Id: 739707456532480
    m_Localized: "Verdiene Uran, indem du Uran-Meteoriten zerst\xF6rst:"
    m_Metadata:
      m_Items: []
  - m_Id: 739583590346752
    m_Localized: "On a r\xE9ussie a avoir les particules d\u2019\xE9toile ! Utilises
      les j\u2019ai hate de voir ce qu\u2019on va avoir avec ! "
    m_Metadata:
      m_Items: []
  - m_Id: 739708047929344
    m_Localized: 'Verbessere das Raumschiff mit Uran:'
    m_Metadata:
      m_Items: []
  - m_Id: 857070512320512
    m_Localized: "Gl\xFCckwunsch! Du hast alle Quests abgeschlossen! Jetzt ist es
      Zeit, das Raumschiff zu wechseln!"
    m_Metadata:
      m_Items: []
  - m_Id: 1245777727795200
    m_Localized: "Passons aux choses s\xE9rieuse, si on veut s\u2019en sortir il
      va falloir commencer a produire du bois en grande quantit\xE9 ! "
    m_Metadata:
      m_Items: []
  - m_Id: 1245862343684096
    m_Localized: "Olalala j\u2019ai jamais vu autant de bois de toute ma vie !! Tu
      vas pouvoir nous cr\xE9er une vrai forteresse avec ! "
    m_Metadata:
      m_Items: []
  - m_Id: 1245862968635392
    m_Localized: "Tues ces \xE9normes cr\xE9atures avant qu\u2019elle nous d\xE9truises
      ! "
    m_Metadata:
      m_Items: []
  - m_Id: 1246248500670464
    m_Localized: 'Verbessere die Generatoren in deinen Schmieden:'
    m_Metadata:
      m_Items: []
  - m_Id: 1246249826070528
    m_Localized: 'Kauf einen zweiten Eisengenerator:'
    m_Metadata:
      m_Items: []
  - m_Id: 1246252795637760
    m_Localized: "Beende {stage} m\xF6gliche Wellen in 5 Minuten:"
    m_Metadata:
      m_Items:
      - rid: 9040802075139375378
  - m_Id: 101960174984335360
    m_Localized: Obtiens du bois avec la forge de ton vaisceaux
    m_Metadata:
      m_Items: []
  - m_Id: 106556196201009152
    m_Localized: 'Elimines les boss :'
    m_Metadata:
      m_Items: []
  - m_Id: 106556863871291392
    m_Localized: 'Traverses des trous noirs : '
    m_Metadata:
      m_Items: []
  - m_Id: 106564855266119680
    m_Localized: "Am\xE9liore ton vaisceaux avec les particules d'\xE9toiles  :"
    m_Metadata:
      m_Items: []
  - m_Id: 106581840758673408
    m_Localized: "Obtient ces jolies particules d\u2019\xE9toiles afin d\u2019am\xE9lioration
      d\xE9finitivement ton vaisceaux !"
    m_Metadata:
      m_Items: []
  references:
