--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: UI_Quests_fr-FR
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr-FR
  m_SharedData: {fileID: 11400000, guid: f08e391c545fdab4d9c91542a36284fb, type: 2}
  m_Metadata:
    m_Items:
    - rid: 9040802075139375377
  m_TableData:
  - m_Id: 5438910464
    m_Localized: "Une vague de m\xE9t\xE9orite approche, j'ai peur  ! "
    m_Metadata:
      m_Items: []
  - m_Id: 285480005632
    m_Localized: "Nettoies l'espace des m\xE9t\xE9orites : "
    m_Metadata:
      m_Items: []
  - m_Id: 85868537655296
    m_Localized: "Il faut obtenir le plus de bois possible pour renforcer le vaisceaux
      avant la prochaine vague de m\xE9t\xE9orite."
    m_Metadata:
      m_Items: []
  - m_Id: 86366347014144
    m_Localized: "Tues des m\xE9t\xE9orites de {0} : "
    m_Metadata:
      m_Items: []
  - m_Id: 336272101945344
    m_Localized: "Am\xE9liore ton vaisceaux :"
    m_Metadata:
      m_Items: []
  - m_Id: 336869618298880
    m_Localized: "Pour survivre plus longtemps, notre vaisseau doit \xEAtre renforc\xE9
      ! Utilise ton fer pour l'am\xE9liorer."
    m_Metadata:
      m_Items: []
  - m_Id: 466121177116672
    m_Localized: "Obtiens des particules d'\xE9toiles en un prestige :"
    m_Metadata:
      m_Items: []
  - m_Id: 466124553531392
    m_Localized: "Trouves ces fameuses m\xE9t\xE9orites de bois pour augmenter les
      ressources. "
    m_Metadata:
      m_Items: []
  - m_Id: 470882718789632
    m_Localized: "Il faut vite trouver une solution ! Si on ne d\xE9truis pas ce
      boss on va\u2026 on sera foutu."
    m_Metadata:
      m_Items: []
  - m_Id: 738363026911232
    m_Localized: "Il faut absolument qu\u2019on d\xE9couvre ce qu\u2019il y a d\xE9rri\xE8re
      la poussi\xE8re d\u2019\xE9toile. Peut \xEAtre qu\u2019elle pourra nous sauver."
    m_Metadata:
      m_Items: []
  - m_Id: 739707456532480
    m_Localized: "Gagnes de l'Uranium en d\xE9truisants des m\xE9t\xE9orites d'Uranium
      : "
    m_Metadata:
      m_Items: []
  - m_Id: 739583590346752
    m_Localized: "On a r\xE9ussie a avoir les particules d\u2019\xE9toile ! Utilises
      les j\u2019ai hate de voir ce qu\u2019on va avoir avec ! "
    m_Metadata:
      m_Items: []
  - m_Id: 739708047929344
    m_Localized: "Am\xE9liores le vaisceaux avec l'uranium : "
    m_Metadata:
      m_Items: []
  - m_Id: 857070512320512
    m_Localized: "Bravo ! Vous avez finis toute les qu\xEAtes ! Il est temps de changer
      de vaisceaux maintenant !"
    m_Metadata:
      m_Items: []
  - m_Id: 1245777727795200
    m_Localized: "Passons aux choses s\xE9rieuse, si on veut s\u2019en sortir il
      va falloir commencer a produire du bois en grande quantit\xE9 ! "
    m_Metadata:
      m_Items: []
  - m_Id: 1245862343684096
    m_Localized: "Olalala j\u2019ai jamais vu autant de bois de toute ma vie !! Tu
      vas pouvoir nous cr\xE9er une vrai forteresse avec ! "
    m_Metadata:
      m_Items: []
  - m_Id: 1245862968635392
    m_Localized: "Tues ces \xE9normes cr\xE9atures avant qu\u2019elle nous d\xE9truises
      ! "
    m_Metadata:
      m_Items: []
  - m_Id: 1246248500670464
    m_Localized: "Am\xE9liore des g\xE9n\xE9rateurs de tes forges :"
    m_Metadata:
      m_Items: []
  - m_Id: 1246249826070528
    m_Localized: "Ach\xE8te un deuxi\xE8me g\xE9n\xE9rateur de {0} :"
    m_Metadata:
      m_Items: []
  - m_Id: 1246252795637760
    m_Localized: 'Termine {stage} vagues possible en 5 minutes :'
    m_Metadata:
      m_Items:
      - rid: 9040802075139375377
  - m_Id: 101960174984335360
    m_Localized: Obtiens du bois avec la forge de ton vaisceaux
    m_Metadata:
      m_Items: []
  - m_Id: 106556196201009152
    m_Localized: 'Elimines les boss :'
    m_Metadata:
      m_Items: []
  - m_Id: 106556863871291392
    m_Localized: 'Traverses des trous noirs : '
    m_Metadata:
      m_Items: []
  - m_Id: 106564855266119680
    m_Localized: "Am\xE9liore ton vaisceaux avec les particules d'\xE9toiles  :"
    m_Metadata:
      m_Items: []
  - m_Id: 106581840758673408
    m_Localized: "Obtient ces jolies particules d\u2019\xE9toiles afin d\u2019am\xE9lioration
      d\xE9finitivement ton vaisceaux !"
    m_Metadata:
      m_Items: []
  - m_Id: 116748650250342400
    m_Localized: On est bien plus fort qu'avant, donc maintenant il va falloir utiliser
      les grands moyens !
    m_Metadata:
      m_Items: []
  - m_Id: 116748921684725760
    m_Localized: "Et si on jouait a un petit jeu ? Tu penses r\xE9ussir a battre
      les 10 premi\xE8res vagues en moins de 5 minute ? "
    m_Metadata:
      m_Items: []
  - m_Id: 116748973593432064
    m_Localized: "Bon, la c'\xE9tait serr\xE9.. Heureusement il existe certain bonus
      qui permettent d'avancer plus vite gr\xE2ce aux poussi\xE8res d'\xE9toiles
      ! "
    m_Metadata:
      m_Items: []
  - m_Id: 116749224240844800
    m_Localized: "Il nous faut plus de machine si on veut s\u2019armer pour la suite,
      d\xE9bloques toutes les machines!"
    m_Metadata:
      m_Items: []
  - m_Id: 116749435633766400
    m_Localized: "Allez un peu de d\xE9fis maintenant, tu penses que cette fois tu
      vas y arrivas aussi facilement ? "
    m_Metadata:
      m_Items: []
  - m_Id: 116749763036942336
    m_Localized: "Il y a encore trop de m\xE9t\xE9orites g\xE9antes en libert\xE9,
      tu pourrais faire un petit nettoyage ? "
    m_Metadata:
      m_Items: []
  - m_Id: 116750016200937472
    m_Localized: "Alors tu t\u2019es familiaris\xE9 avec l\u2019uranium ? Et si tu
      ferai une petite r\xE9serve ? "
    m_Metadata:
      m_Items: []
  - m_Id: 116750395068223488
    m_Localized: "L\u2019uranium c\u2019est bien mais il ne faut pas n\xE9gliger
      la puissance du fer, c\u2019est la base de notre vaisseaux, r\xE9coltes en
      un peu."
    m_Metadata:
      m_Items: []
  - m_Id: 116750426588418048
    m_Localized: "On est si puissant maintenant !! C\u2019est l\u2019heure du grand
      nettoyage."
    m_Metadata:
      m_Items: []
  - m_Id: 116750438412161024
    m_Localized: "C\u2019est l\u2019heure du d\xE9fis ! La si tu y arrives je serais
      vraiment tr\xE8s impression\xE9 ! "
    m_Metadata:
      m_Items: []
  - m_Id: 116750463573790720
    m_Localized: "On a beau avoir plein de fer et d\u2019uranium, sans particule
      d\u2019\xE9toile on restera toujours aussi lent ! "
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds:
